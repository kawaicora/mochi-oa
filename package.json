{
  "name": "mochi-oa",
  "version": "12.9.12",
  "description": "麻薯-好用简洁的办公软件",
  "main": "./out/main/index.js",
  "author": "零食大礼包",
  "private": true,
  "build": {
    "appId": "com.mochi.oa",
    "productName": "麻薯",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "!**/node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "icon": "resources\\mochi_256.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "resources\\mochi_256.png",
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "resources\\mochi_256.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "executableName": "mochi-oa"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "electron-vite build",
    "obf": "node tools/compile-bytenode.mjs",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "dist:win": "npm run build && npm run obf && node scripts/apply-branding.mjs --win",
    "dist:mac": "npm run build && npm run obf && node scripts/apply-branding.mjs --mac",
    "dist:linux": "npm run build && npm run obf && node scripts/apply-branding.mjs --linux"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@types/qrcode": "^1.5.6",
    "bytenode": "^1.7.0",
    "docx-preview": "^0.4.1",
    "flatpickr": "^4.6.13",
    "flv.js": "^1.6.2",
    "iconv-lite": "^0.7.3",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "livekit-client": "^2.23.0",
    "lunar-javascript": "^1.7.7",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.7.5",
    "systeminformation": "^5.33.15",
    "three": "^0.186.1",
    "vue": "^3.4.31",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^30.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^5.3.1",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vitest": "^1.6.1",
    "vue-tsc": "^2.0.26"
  }
}
